#!/usr/bin/env Rscript
#Script 12. R script for characterisation of transcriptome evolution across cell populations

library(Seurat)
library(scibet)
library(dplyr)
library(tibble)
library(phytools)
library(ggplot2)

##### input data #####
path_to_output_of_integration <- 'XXX' #path to put the output of integration
path_to_output_of_transcriptome_characterisation <- 'XXX' #path to put the output of analyses in this script

#Read Seurat object
my.se <- readRDS(paste0(path_to_output_of_integration,'integrated_dataset_final.rds'))

#Input tables
TAI_table <- read.table('XXX') #path to table containing TAI values 
Tau_table <- read.table('XXX') #path to table containing tissue specificity values
PPI_table <- read.table('XXX') #path to table containing high-confidence PPIs
dNdS_table <- read.table('XXX') #path to table containing dNdS values for protein-coding genes

##### function to calculate weighted average per cell #####
#Create function to calculate for each cell the weighted average across all genes expressed
function_average_within_cell <- function(Seurat_obj, ident_of_Seurat_obj, table, value_column_of_table, geneID_column_of_table){

  #Create matrix of data and table of metadata for Seurat object
  data <- GetAssayData(Seurat_obj,slot='data',assay='RNA')
  meta <- Seurat_obj@meta.data

  #Remove any potential NA from the table
  table <- df[!is.na(table[, value_column_of_table]), c(geneID_column_of_table, value_column_of_table)]
  rownames(table) <- table[ ,geneID_column_of_table]

  #select genes expressed in data object
  data_genes_in_common <- data[intersect(rownames(data), table[ ,geneID_column_of_table]),]

  #Get unique values for ident
  meta[,ident_of_Seurat_obj] <- factor(meta[,ident_of_Seurat_obj])
  uniq_ident_of_Seurat_obj <- unique(meta[,ident_of_Seurat_obj])

  
  value_by_ident <- lapply(uniq_ident_of_Seurat_obj, function(x){
    y <- rownames(meta[meta[,ident_of_Seurat_obj] == x,]) #get cell IDs that belong to the ident
    matrix <- data_genes_in_common[,y] #subset the data object to these cells

    #Calculate the weighted average value per cell
    weighted_average_per_cell <- lapply(colnames(matrix), function(z){
      gene_exp <- matrix[,z]
      gene_exp <- gene_exp[gene_exp !=0] #only select genes expressed in the cell
      gene_exp <- lapply(gene_exp, function(a){return(expm1(a))}) 
      gene_exp_value <- lapply(names(gene_exp), function(n) {return(df[n, to_calculate]*gene_exp[[n]])})
      gene_exp_value <- unlist(gene_exp_value)
      gene_exp_value_ave <- sum(gene_exp_value)/sum(unlist(gene_exp)) 
      return(gene_exp_value_ave)
      })
    
    values_per_ident <- data.frame("weightAve"=unlist(weighted_average_per_cell),"ident"=x)
    return(values_per_ident)
  })

  #Create a dataframe containing all values across all idents
  all_values <- Reduce(rbind, values_per_ident) 
  return(all_values_per_ident)
}

##### calculate values per cell using the function #####
TAI <- function_average_within_cell(my.se, "CellTypes", TAI_table, "PSnum", "geneID")
saveRDS(TAI,paste0(path_to_output_of_transcriptome_characterisation,'TAI.rds')

Tau <- function_average_within_cell(my.se, "CellTypes", Tau_table, "CellTypeSpe", "geneID")
saveRDS(Tau,paste0(path_to_output_of_transcriptome_characterisation,'Tau.rds')

PPI <- function_average_within_cell(my.se, "CellTypes", PPI_table, "Freq", "geneID")
saveRDS(TAI,paste0(path_to_output_of_transcriptome_characterisation,'PPI.rds')

dNdS <- function_average_within_cell(my.se, "CellTypes", dNdS_table, "dNdS", "geneID")
saveRDS(dNdS,paste0(path_to_output_of_transcriptome_characterisation,'dNdS.rds')


##### statistical support #####

function_t_test_CellType <- function(metric,title) {
  metric<-lapply(seq_along(metric), function(i) {
    metric[[i]]$species <- species[[i]]
    return(metric[[i]])
  })
  
  metric_all <- do.call('rbind',metric)
  metric_all$weightAve <- as.numeric(metric_all$weightAve)

  metric_all_all_summary <- metric_all_all %>% group_by(celltype,species) %>%summarise(mean=mean(weightAve))
  Tau_NoLog_all_summary$celltype <- factor(Tau_NoLog_all_summary$celltype,levels=unique(cat_CellTypes))
  print(head(Tau_NoLog_all_summary))
  
  library(phytools)
  library(ape)
  tree_raw<-read.tree("/scicore/home/salzburg/fages0000/scRNA/Seurat/scripts/integration/b1.tre")
  exclude <- tree_raw$tip.label[! tree_raw$tip.label %in% species]
  tree <- ape::drop.tip(phy=tree_raw, tip=exclude, root.edge = F, rooted = is.rooted(tree_raw))
  
  create_vector <- function(ct) {
    aux <- as.data.frame(na.omit(Tau_NoLog_all_summary[Tau_NoLog_all_summary$celltype==ct,]))
    exclude_aux <- tree$tip.label[!(tree$tip.label %in% aux$species)]
    tree_aux <- ape::drop.tip(phy=tree, tip=exclude_aux, root.edge = F, rooted = is.rooted(tree))
    aux <- aux[match(tree_aux$tip.label,aux$species),]
    rownames(aux) <- aux$species
    return(aux)
  }
  
  celltypes <- levels(unique(Tau_NoLog_all_summary$celltype))[1:24]
  print(celltypes)
  
  phylopaired <- lapply(celltypes, function(x) unlist(lapply(celltypes, function(y) {
    if (x != y) {
      X <- create_vector(x)
      Y <- create_vector(y)
      species_X <- unique(X$species)
      species_Y <- unique(Y$species)
      species_intersect <- intersect(species_X,species_Y)
      exclude_X_Y <- tree$tip.label[!(tree$tip.label %in% species_intersect)]
      tree_X_Y <- ape::drop.tip(phy=tree, tip=exclude_X_Y, root.edge = F, rooted = is.rooted(tree))
      return(phyl.pairedttest(tree_X_Y,X[,3,drop=F],Y[,3,drop=F])$P.dbar)
    } else {return(1)}})))
  
  print(phylopaired)
  matrix_phylopaired <- do.call('rbind',phylopaired)
  
  colnames(matrix_phylopaired) <- celltypes
  rownames(matrix_phylopaired) <- celltypes
  
  means <- tapply(Tau_NoLog_all_summary$mean, Tau_NoLog_all_summary$celltype, mean)
  
  # Expand to pairwise differences
  diff_mat <- outer(means, means, "-")  # matrix[i,j] = mean(i) - mean(j)
  print(diff_mat)
  
  library(pheatmap)
  #pheatmap(-log10(matrix_phylopaired),cluster_rows = T,cluster_cols = T)
  
  #Keep uper triangle
  matrix_phylopaired[lower.tri(matrix_phylopaired, diag = TRUE)] <- NA
  diff_mat[lower.tri(diff_mat, diag = TRUE)] <- NA
  
  
  # Melt matrix
  library(reshape2)
  p_df <- melt(matrix_phylopaired, na.rm = TRUE)
  colnames(p_df) <- c("CellType1", "CellType2", "p_value")
  
  d_df <- melt(diff_mat)
  colnames(d_df) <- c("CellType1", "CellType2", "diff")
  
  # Merge
  plot_df <- merge(p_df, d_df, by = c("CellType1", "CellType2"))
  
  # Add signed log p-value
  plot_df$signed_log_p <- sign(plot_df$diff) * -log10(plot_df$p_value)
  
  plot_df$log_p <- -log10(plot_df$p_value)
  plot_df$signif <- cut(plot_df$p_value,
                        breaks = c(-Inf, 0.001, 0.01, 0.05, Inf),
                        labels = c("***", "**", "*", ""))
  
  
  ggplot(plot_df, aes(x = CellType1, y = CellType2, fill = signed_log_p)) +
    geom_tile(color = "white") +
    scale_fill_gradient2(
      low = "blue", mid = "white", high = "red",
      midpoint = 0, name = "Signed -log10(p)") +
    geom_text(aes(label = signif), size = 4, color = "black")  +
    theme_classic() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
    labs(title = "Pairwise significance Heatmap",
         x = "Cell population 1", y = "Cell population 2") + coord_flip() + 
    scale_x_discrete(limits=rev) + ggtitle(title)
  
  # ggplot(p_df, aes(x = CellGroup1, y = CellGroup2, fill = signed_log_p)) +
  #   geom_tile(color = "white") +
  #   scale_fill_gradient(low = "white", high = "red", name = "-log10(p)") +
  #   geom_text(aes(label = signif), size = 4, color = "black") +
  #   theme_minimal() +
  #   theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
  #   labs(title = "Pairwise Significance Heatmap", x = "Cell Group", y = "Cell Group")
}



